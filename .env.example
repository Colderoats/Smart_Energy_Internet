POSTGRES_USER=sei_user
POSTGRES_PASSWORD=sei_password
POSTGRES_DB=sei_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Module 5 — blockchain ledger (backend/app/blockchain, contract in blockchain/)
# local = Hardhat node (`npm run node` in blockchain/); sepolia = public testnet.
BLOCKCHAIN_NETWORK=local
# BLOCKCHAIN_ENABLED=true
# Sepolia: RPC endpoint (e.g. Infura/Alchemy) and the PRIVATE KEY of the account
# that runs `npm run deploy:sepolia` (only the deployer may append records).
# Never commit real keys; this account needs Sepolia test ETH for gas.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
# BLOCKCHAIN_CONFIRMATIONS_SEPOLIA=3
# Dev-only tamper demo endpoint (default: on for local, off for sepolia)
# BLOCKCHAIN_DEV_TOOLS=

# Admin authentication (backend/app/auth). Never commit real values.
# REQUIRED: the backend refuses to start without it (>= 32 chars). Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# The only origin allowed by CORS and by the Origin check on POSTs/WebSockets.
FRONTEND_ORIGIN=http://localhost:5173
# Secure cookies need HTTPS. false ONLY for local http dev; leave true in production.
COOKIE_SECURE=false
# COOKIE_DOMAIN=
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# INVITE_TTL_HOURS=48
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=15
# Per-IP rate limits, "<max requests>/<window seconds>"
# LOGIN_RATE_LIMIT=10/60
# REGISTER_RATE_LIMIT=5/60
# REFRESH_RATE_LIMIT=30/60
# X-Forwarded-For is trusted only from these peers (the Vite dev proxy)
# TRUSTED_PROXIES=127.0.0.1,::1
# Expose FastAPI /docs and /openapi.json (public when on; default off)
# API_DOCS_ENABLED=false
# First admin via backend/scripts/create_admin.py (optional non-interactive input)
# SEI_ADMIN_EMAIL=
# SEI_ADMIN_PASSWORD=
